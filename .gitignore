# Build outputs
build/bin/
*.exe
*.syso
# Bundled ConPTY host redistributable (see resources/conpty/, pkg/conpty/conpty_windows.go)
!resources/conpty/**/*.exe

# Node dependencies & dist
node_modules/
frontend/node_modules/
frontend/dist/

# Wails generated bindings (regenerated by `wails build` / `wails dev`)
frontend/wailsjs/

# Wails dev & system files
.wails/
.idea/
.vscode/
*.log
